<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Area Layar -->
    <RelativeLayout
        android:id="@+id/layoutLayar"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#FFFFFF"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvEkspresi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="end"
            android:text=""
            android:textColor="#333333"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="end"
            android:text="0"
            android:textColor="#999999"
            android:textSize="24sp" />
    </RelativeLayout>

    <!-- Baris 1 -->
    <Button
        android:id="@+id/btnC"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutLayar"
        android:onClick="onKlikTombol"
        android:text="C"
        android:textColor="#F44336" />

    <Button
        android:id="@+id/btnKurung"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutLayar"
        android:layout_toEndOf="@id/btnC"
        android:onClick="onKlikTombol"
        android:text="( )"
        android:textColor="#2196F3" />

    <Button
        android:id="@+id/btnPersen"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutLayar"
        android:layout_toEndOf="@id/btnKurung"
        android:onClick="onKlikTombol"
        android:text="%"
        android:textColor="#2196F3" />

    <Button
        android:id="@+id/btnBagi"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutLayar"
        android:layout_toEndOf="@id/btnPersen"
        android:onClick="onKlikTombol"
        android:text="/"
        android:textColor="#2196F3" />

    <!-- Baris 2 -->
    <Button
        android:id="@+id/btn7"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnC"
        android:onClick="onKlikTombol"
        android:text="7"
        android:textColor="#2196F3"
        />

    <Button
        android:id="@+id/btn8"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnC"
        android:layout_toEndOf="@id/btn7"
        android:onClick="onKlikTombol"
        android:text="8"
        android:textColor="#2196F3"
        />

    <Button
        android:id="@+id/btn9"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnC"
        android:layout_toEndOf="@id/btn8"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="9" />

    <Button
        android:id="@+id/btnKali"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnC"
        android:layout_toEndOf="@id/btn9"
        android:onClick="onKlikTombol"
        android:text="*"
        android:textColor="#2196F3" />

    <!-- Baris 3 -->
    <Button
        android:id="@+id/btn4"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn7"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="4" />

    <Button
        android:id="@+id/btn5"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn7"
        android:layout_toEndOf="@id/btn4"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="5" />

    <Button
        android:id="@+id/btn6"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn7"
        android:layout_toEndOf="@id/btn5"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="6" />

    <Button
        android:id="@+id/btnKurang"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn7"
        android:layout_toEndOf="@id/btn6"
        android:onClick="onKlikTombol"
        android:text="-"
        android:textColor="#2196F3" />

    <!-- Baris 4 -->
    <Button
        android:id="@+id/btn1"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn4"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="1" />

    <Button
        android:id="@+id/btn2"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn4"
        android:layout_toEndOf="@id/btn1"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="2" />

    <Button
        android:id="@+id/btn3"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn4"
        android:layout_toEndOf="@id/btn2"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="3" />

    <Button
        android:id="@+id/btnTambah"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn4"
        android:layout_toEndOf="@id/btn3"
        android:onClick="onKlikTombol"
        android:text="+"
        android:textColor="#2196F3" />

    <!-- Baris 5 -->
    <Button
        android:id="@+id/btn0"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn1"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="0" />

    <Button
        android:id="@+id/btn00"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn1"
        android:layout_toEndOf="@id/btn0"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="00" />

    <Button
        android:id="@+id/btnTitik"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn1"
        android:layout_toEndOf="@id/btn00"
        android:onClick="onKlikTombol"
        android:textColor="#2196F3"
        android:text="." />

    <Button
        android:id="@+id/btnSamaDengan"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:layout_below="@id/btn1"
        android:layout_toEndOf="@id/btnTitik"
        android:backgroundTint="#3F51B5"
        android:onClick="onKlikTombol"
        android:text="="
        android:textColor="#FFFFFF" />

</RelativeLayout>
